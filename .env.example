# Copy to .env.local and fill in. Never commit .env.local.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: where the local PGlite database and magic-link files live (default: ./data)
# RESUME_DATA_DIR=/absolute/path
# Postgres connection string. Leave unset to use a local PGlite database under data/pglite.
# Only one process can open the PGlite folder at a time: stop `npm run dev` before running scripts against it.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Sign-in (Better Auth) ---
# Signs session cookies; generate with `openssl rand -base64 32`. Required in production. Unset in development: a fixed dev-only secret is used.
# BETTER_AUTH_SECRET=
# Public URL of the app, used in sign-in links and OAuth redirects. Required in production, and must be https://. Default: http://localhost:3000
# BETTER_AUTH_URL=https://resume.example.com
# Google sign-in; set both or neither. Redirect URI is <BETTER_AUTH_URL>/api/auth/callback/google. Unset: no Google sign-in.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# How sign-in links are delivered: "resend" (default in production) or "file" (default in development), which writes
# them to data/magic-links/<email>.txt and logs them. In production "file" is only accepted with an http:// BETTER_AUTH_URL,
# for smoke-testing the production build locally.
# EMAIL_TRANSPORT=resend
# Resend API key; required when EMAIL_TRANSPORT is "resend".
# RESEND_API_KEY=
# Sender for sign-in emails; must be on a domain verified in Resend. Required in production. Default: Resume Tailor <signin@localhost>
# EMAIL_FROM=Resume Tailor <signin@example.com>
# Private beta: comma-separated emails allowed to create an account (case-insensitive). Unset: anyone can sign up.
# Existing accounts can always sign in.
# SIGNUP_EMAILS=ada@example.com,grace@example.com

# --- LaTeX ---
# Where each compile gets its own temporary folder. Default: the system temp folder.
# COMPILE_ROOT=/var/lib/compile
# Run TeX as a separate user per compile slot, through `sudo -n -u <user> -- /usr/bin/timeout ...`, so a document
# cannot read the server's files or environment, or another running compile's folder. The value is a user-name
# prefix: slot 1 runs as `<prefix>1` in a folder handed to group `<prefix>run1`, slot 2 as `<prefix>2` with
# `<prefix>run2`, and so on. The server's user must be in every such group, each TeX user only in its own, and
# sudoers must let the server run /usr/bin/timeout as each of them (the Docker image sets all this up for tex1, tex2).
# Requires COMPILE_ROOT: a folder the server owns that the TeX users may pass through but not list.
# Unset: TeX runs as the server's user.
# LATEX_RUN_AS=tex
# How many compiles may run at once; up to 8 more wait their turn and the rest are told to retry (503). With
# LATEX_RUN_AS it must not exceed the TeX users that exist (the image's COMPILE_SLOTS build arg, default 2).
# Default: 2
# COMPILE_CONCURRENCY=2
# latexmk to run. Default: latexmk from PATH.
# LATEXMK_PATH=/Library/TeX/texbin/latexmk

# --- Plans, credits and ads ---
# "hosted" runs plans, credits, ads and limits; "selfhost" is a single-operator tool with none of them and a model
# picker. Sign-up follows SIGNUP_EMAILS in both modes: selfhost does not open it.
# Default: hosted in production, selfhost otherwise.
# APP_MODE=selfhost
# Comma-separated emails that get the unlimited plan (case-insensitive). Applied when an account's plan is first
# created: at sign-up, or on the first request of an account from before plans existed. Set it before the first
# deploy of this version so the existing owner account heals to unlimited; adding an email later does not upgrade
# an account that already has a plan. Default: none.
# ADMIN_EMAILS=you@example.com
# Rewarded-ad network: "none", "test" or "google". Always "none" in selfhost mode. Default: none
# "test" is for development and the e2e tests only: a fake ad that plays for AD_MIN_WATCH_SECONDS + 1 seconds and then
# grants a credit, so it is refused in production. Try the earn flow locally with APP_MODE=hosted, AD_PROVIDER=test
# and AD_MIN_WATCH_SECONDS=1.
# AD_PROVIDER=none
# Google Ad Manager rewarded ad unit path; required when AD_PROVIDER=google in hosted production. Default: unset
# AD_UNIT_PATH=/1234567/resume-tailor-rewarded
# Grant ad credits only through Google's server-side verification callback: 1/true or 0/false. Default: false
# AD_SSV_ENABLED=false
# Where the ad network publishes the keys that sign its server-side verification callbacks (https only; cached 24 h).
# The default is AdMob's verifier key list; confirm the URL for Ad Manager web rewarded ads before enabling SSV.
# Default: https://www.gstatic.com/admob/reward/verifier-keys.json
# AD_SSV_KEYS_URL=https://www.gstatic.com/admob/reward/verifier-keys.json
# Model for free accounts. Default: claude-haiku-5-5
# FREE_MODEL=claude-haiku-5-5
# Model for unlimited accounts and self-hosting when none is picked. Default: claude-sonnet-5-5
# UNLIMITED_MODEL=claude-sonnet-5-5
# Credits one AI tailor costs a free account. 0 makes tailoring free for free accounts; the daily budget
# (FREE_DAILY_BUDGET_GBP) still applies. Default: 2
# CREDITS_PER_TAILOR=2
# Credits one chat message costs a free account. Default: 1
# CREDITS_PER_CHAT_MESSAGE=1
# Most ad-earned credits per account per UTC day. Default: 10
# AD_CREDITS_PER_ACCOUNT_PER_DAY=10
# Most ad-earned credits per client IP per UTC day. Default: 30
# AD_CREDITS_PER_IP_PER_DAY=30
# Seconds that must pass between an ad starting and its credit being granted. Default: 7
# AD_MIN_WATCH_SECONDS=7
# Credits a new account starts with. Default: 0
# SIGNUP_GRANT_CREDITS=0
# Daily budget for free accounts, in GBP: the sum of the costed Claude calls free accounts made since midnight UTC.
# Once it is reached, free tailoring and chat answer 402 until the next midnight UTC; unlimited and self-hosted
# accounts are never paused. 0 keeps free usage paused all the time. Default: 2
# The operator can also pause free usage by hand, whatever the budget. Pause, then resume, in psql:
#   insert into settings (key, value) values ('free_paused', 'true') on conflict (key) do update set value = excluded.value, updated_at = now();
#   insert into settings (key, value) values ('free_paused', 'false') on conflict (key) do update set value = excluded.value, updated_at = now();
# Any value other than false pauses, so a mistyped value keeps free usage off rather than on.
# FREE_DAILY_BUDGET_GBP=2
# GBP per USD, used to cost Claude calls at Anthropic's USD list prices (src/billing/costs.ts). A model missing from
# that price table is costed at Opus prices and logged at boot. Default: 0.78
# USD_TO_GBP=0.78
