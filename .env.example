# Copy to .env.local and fill in. Never commit .env.local.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: where profiles live (default: ./data)
# RESUME_DATA_DIR=/absolute/path
# Postgres connection string. Leave unset to use a local PGlite database under data/pglite.
# Only one process can open the PGlite folder at a time: stop `npm run dev` before running scripts against it.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Sign-in (Better Auth) ---
# Signs session cookies; generate with `openssl rand -base64 32`. Unset in development: a fixed dev-only secret is used.
# BETTER_AUTH_SECRET=
# Public URL of the app, used in sign-in links and OAuth redirects. Default: http://localhost:3000
# BETTER_AUTH_URL=https://resume.example.com
# Google sign-in; redirect URI is <BETTER_AUTH_URL>/api/auth/callback/google. Unset in development: no Google sign-in.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Sends magic-link emails. Unset in development: links are written to data/magic-links/<email>.txt and logged instead.
# RESEND_API_KEY=
# Sender for sign-in emails; must be a domain verified in Resend. Default: Resume Tailor <signin@localhost>
# EMAIL_FROM=Resume Tailor <signin@example.com>
